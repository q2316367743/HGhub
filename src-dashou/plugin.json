{
  "$schema": "../node_modules/@dashou/cli/schema/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.hghub",
  "name": "HGhub 黄果短剧",
  "version": "1.0.0",
  "description": "黄果短剧第三方客户端：沉浸式竖屏播放、分类、榜单、搜索与吃瓜。",
  "author": { "name": "dashou" },
  "icon": "assets/icon.png",
  "csp": "media-src 'self' plugin: data: blob:; worker-src blob:",
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": false,
  "windows": [
    {
      "label": "main",
      "title": "HGhub",
      "url": "ui/index.html",
      "width": 1200,
      "height": 780,
      "minWidth": 900,
      "minHeight": 620,
      "center": true,
      "resizable": true,
      "decorations": false,
      "backgroundColor": "#1a1a1a"
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "打开 HGhub",
      "description": "黄果短剧 · 沉浸式竖屏播放",
      "keywords": ["hghub", "hg", "黄果", "短剧", "追剧", "吃瓜", "黄果短剧"],
      "mode": "window",
      "window": "main"
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": ["main"],
      "permissions": [
        "core:event:allow-listen",
        "core:window:allow-close",
        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-is-maximized",
        "clipboard-manager:allow-write-text",
        "opener:allow-open-url"
      ]
    },
    {
      "identifier": "core-base",
      "targets": ["core"],
      "permissions": ["log:allow-log"]
    }
  ],
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  }
}
