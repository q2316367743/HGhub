{
  "$schema": "https://da-shou.cn/schemas/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.hghub",
  "name": "HGhub 黄果短剧",
  "version": "1.0.0",
  "description": "黄果短剧第三方客户端：沉浸式竖屏播放、分类、榜单、搜索与吃瓜。",
  "author": {
    "name": "dashou"
  },
  "csp": "media-src 'self' plugin: data: blob:; worker-src blob:",
  "icon": "assets/icon.png",
  "platforms": [
    "macos",
    "windows",
    "linux"
  ],
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": false,
  "windows": [
    {
      "label": "main",
      "title": "HGhub",
      "url": "ui/index.html",
      "width": 1200,
      "height": 780,
      "minWidth": 900,
      "minHeight": 620,
      "resizable": true,
      "maximizable": true,
      "minimizable": true,
      "closable": true,
      "fullscreen": false,
      "transparent": false,
      "center": true,
      "decorations": false,
      "alwaysOnTop": false,
      "skipTaskbar": false,
      "shadow": true,
      "hiddenTitle": false,
      "backgroundColor": "#1a1a1a",
      "focus": true,
      "maximized": false,
      "visible": true,
      "visibleOnAllWorkspaces": false,
      "contentProtected": false,
      "showOnActivate": true
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "打开 HGhub",
      "description": "黄果短剧 · 沉浸式竖屏播放",
      "keywords": [
        "hghub",
        "hg",
        "黄果",
        "短剧",
        "追剧",
        "吃瓜",
        "黄果短剧"
      ],
      "match": {
        "type": "keyword"
      },
      "mode": "window",
      "window": "main",
      "acceptsInput": false
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": [
        "main"
      ],
      "permissions": [
        "core:event:allow-listen",
        "core:window:allow-close",
        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-is-maximized",
        "clipboard-manager:allow-write-text",
        "opener:allow-open-url"
      ],
      "scope": {}
    },
    {
      "identifier": "core-base",
      "targets": [
        "core"
      ],
      "permissions": [
        "log:allow-log"
      ],
      "scope": {}
    }
  ]
}
